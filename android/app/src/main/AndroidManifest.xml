<?xml version="1.0" encoding="utf-8" ?>
<!--
  The Android shell around the Rust application.

  The activity is a NativeActivity (through GpuiActivity and
  GpuiInputActivity, which add the splash screen and a real InputConnection
  for the soft keyboard). It loads the shared object named by
  `android.app.lib_name`, which is the `tresse-gui` crate built as a
  cdylib, and calls `android_main` in it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Syncing a folder with its storage: the only permission there is.
         Folders are picked through the Storage Access Framework, which grants
         access to the one tree the person chose; no storage permission is
         declared or ever asked for. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Vulkan where there is one, OpenGL ES 3 where there is not. -->
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:required="false"
        android:version="0"
    />
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:required="false"
        android:version="0x00401000"
    />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false"
    />

    <!-- allowBackup is off: a backup would carry the sync credentials out of
         the application's private directory. -->
    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/GpuiTheme"
    >

        <!-- GpuiPathPicker (CSV import and export through SAF) and the other
             helper activities come with gpui-android-glue's manifest. -->

        <!--
          `configChanges` keeps the activity across rotation and the keyboard
          appearing: the Rust side is told through the NDK instead.
          `singleTask`: one activity is one ledger open once.
        -->
        <activity
            android:name="dev.gpui.mobile.GpuiActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:theme="@style/GpuiSplashTheme"
            android:windowSoftInputMode="adjustResize"
        >

            <!-- Without the `lib` prefix and the `.so` suffix; set in
                 build.gradle.kts. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="${nativeLibraryName}"
            />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The Tresse server's connect page returns the repository's
                 connection string through this link; the connection form
                 fills itself from it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="tresse-connect"
                    android:scheme="tressegui"
                />
            </intent-filter>
        </activity>

        <!-- Asks for a folder through the Storage Access Framework and keeps
             the grant. The result comes back to the activity that asked, so
             the picker is an activity of its own. -->
        <activity
            android:name="app.akergez.tressegui.TreePicker"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:exported="false"
            android:theme="@style/GpuiTheme"
        />

    </application>

</manifest>
