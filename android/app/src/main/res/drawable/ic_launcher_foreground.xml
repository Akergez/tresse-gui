<?xml version="1.0" encoding="utf-8"?>
<!-- The application icon, from data/icons/hicolor/scalable/apps: the same
     paths, scaled by half and centred so that all of it stays inside the
     circle a launcher may cut out of the middle. The tile is the adaptive
     icon's background colour, so the folder is drawn white and the arrows in
     the tile's green. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.5"
        android:scaleY="0.5"
        android:translateX="22"
        android:translateY="22">
        <!-- The folder -->
        <path
            android:fillColor="#f2fbf6"
            android:pathData="M 30 40 H 54 L 62 50 H 98 A 8 8 0 0 1 106 58 V 92 A 8 8 0 0 1 98 100 H 30 A 8 8 0 0 1 22 92 V 48 A 8 8 0 0 1 30 40 Z" />
        <!-- The two arrows of a round trip -->
        <path
            android:strokeColor="#1f7a55"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:pathData="M 46 70 A 15 15 0 0 1 74 64" />
        <path
            android:fillColor="#1f7a55"
            android:pathData="M 74 54 L 86 66 L 70 70 Z" />
        <path
            android:strokeColor="#1f7a55"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:pathData="M 82 90 A 15 15 0 0 1 54 96" />
        <path
            android:fillColor="#1f7a55"
            android:pathData="M 54 106 L 42 94 L 58 90 Z" />
    </group>
</vector>
